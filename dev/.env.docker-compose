DJANGO_SETTINGS_MODULE=net_maestro.settings.development
DJANGO_DATABASE_URL=postgres://postgres:postgres@postgres:5432/django
DJANGO_CELERY_BROKER_URL=amqp://rabbitmq:5672/
DJANGO_MINIO_STORAGE_URL=http://minioAccessKey:minioSecretKey@minio:9000/django-storage
DJANGO_MINIO_STORAGE_MEDIA_URL=http://localhost:9000/django-storage
# When in Docker, the bridge network sends requests from the host machine exclusively via a
# dedicated IP address. Since there's no way to determine the real origin address,
# consider any IP address (though actually this will only be the single dedicated address) to
# be internal. This relies on the host to set up appropriate firewalls for Docker, to prevent
# access from non-internal addresses.
DJANGO_INTERNAL_IPS=0.0.0.0/0

# PHOLD simulation configuration
DJANGO_PHOLD_BINARY_PATH=/opt/ross/phold

# Directory for PHOLD output files
DJANGO_PHOLD_OUTPUT_DIR=/tmp/phold_output

# Number of MPI processes for PHOLD simulations (set to 1 for no MPI)
DJANGO_PHOLD_MPI_PROCESSES=4

# Directory containing example ping pong config and CODES binary
CODE_EXAMPLE_DIR=/opt/codes

# FFW random-traffic binary and config (the "random" traffic mode).
# The config supplies the traffic parameters only: a run rewrites its LP counts and
# topology_yaml_file for whichever topology was picked in the UI, so this applies the
# FABRIC example's flow sizes, interval counts and PAUSE watermarks to any topology.
# Those numbers are sized to oversubscribe a 100 Gbps bottleneck, which is what
# data/topologies/fluid-flow-wan-fabric-5-site.yaml has at STAR->MICH.
DJANGO_FFW_BINARY_PATH=/opt/FFW/build/local/src/model-net-fluid-flow-wan-random-traffic
DJANGO_FFW_CONFIG_PATH=/opt/FFW/build/local/doc/example/fluid-flow-wan-fabric-random-traffic.yaml

# FFW trace-replay binary and config (the "trace" traffic mode)
DJANGO_FFW_TRACE_BINARY_PATH=/opt/FFW/build/local/src/model-net-fluid-flow-wan-trace-traffic
DJANGO_FFW_TRACE_CONFIG_PATH=/opt/FFW/build/local/doc/example/fluid-flow-wan-trace-traffic.yaml

# Directory for FFW output files
DJANGO_FFW_OUTPUT_DIR=/tmp/ffw_output
